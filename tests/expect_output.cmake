# Runs PROGRAM and expects it to print exactly the file EXPECTED.
execute_process(COMMAND ${PROGRAM} RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "${PROGRAM} ended with ${result}")
endif()
if(NOT EXISTS ${EXPECTED})
  message(FATAL_ERROR "${EXPECTED} does not exist. Write it: ${PROGRAM} > ${EXPECTED}")
endif()
file(READ ${EXPECTED} expected)
if(output STREQUAL expected)
  message(STATUS "${EXPECTED} is what ${PROGRAM} prints")
  return()
endif()

# Says where they differ: the first lines that are not the same.
string(REPLACE ";" "," output "${output}")
string(REPLACE ";" "," expected "${expected}")
string(REPLACE "\n" ";" printed "${output}")
string(REPLACE "\n" ";" kept "${expected}")
list(LENGTH printed printed_lines)
list(LENGTH kept kept_lines)
set(shown 0)
set(line 0)
while(line LESS printed_lines AND line LESS kept_lines AND shown LESS 5)
  list(GET printed ${line} now)
  list(GET kept ${line} then)
  math(EXPR line "${line} + 1")
  if(NOT now STREQUAL then)
    message("line ${line}\n  file:    ${then}\n  program: ${now}")
    math(EXPR shown "${shown} + 1")
  endif()
endwhile()
message(FATAL_ERROR "${EXPECTED} is stale (${kept_lines} lines, the program prints ${printed_lines}). "
                    "Write it again: ${PROGRAM} > ${EXPECTED}")
