# Runs PROGRAM and expects it to print exactly the file EXPECTED.
get_filename_component(name ${EXPECTED} NAME)
set(printed ${CMAKE_CURRENT_BINARY_DIR}/${name}.printed)
execute_process(COMMAND ${PROGRAM} RESULT_VARIABLE result OUTPUT_FILE ${printed})
if(NOT result EQUAL 0)
  message(FATAL_ERROR "${PROGRAM} ended with ${result}")
endif()
if(NOT EXISTS ${EXPECTED})
  message(FATAL_ERROR "${EXPECTED} does not exist. Write it: ${PROGRAM} > ${EXPECTED}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${printed} ${EXPECTED} RESULT_VARIABLE differs)
if(differs EQUAL 0)
  message(STATUS "${EXPECTED} is what ${PROGRAM} prints")
  return()
endif()

# Says where they differ, where the machine has `diff`.
find_program(DIFF diff)
if(DIFF)
  execute_process(COMMAND ${DIFF} -u ${EXPECTED} ${printed} OUTPUT_VARIABLE difference)
  string(SUBSTRING "${difference}" 0 6000 difference)
  message("${difference}")
endif()
message(FATAL_ERROR "${EXPECTED} is stale. Write it again: ${PROGRAM} > ${EXPECTED}")
