{
  "$description": "Test tokens for lvgl26, in the W3C Design Tokens format. Three tiers: primitive values, semantic roles, component tokens.",
  "primitive": {
    "color": {
      "$type": "color",
      "blue-500": {
        "$value": {"colorSpace": "srgb", "components": [0.2, 0.4, 1], "hex": "#3366ff"}
      },
      "ink-900": {
        "$value": {"colorSpace": "srgb", "components": [0.051, 0.0667, 0.0902], "hex": "#0d1117"}
      },
      "ink-700": {
        "$value": {"colorSpace": "srgb", "components": [0.1059, 0.1412, 0.1882], "hex": "#1b2430"}
      },
      "ink-500": {
        "$value": {"colorSpace": "srgb", "components": [0.1882, 0.2118, 0.2392], "hex": "#30363d"}
      },
      "paper": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9,
            0.93,
            0.95
          ],
          "hex": "#e6edf3"
        }
      },
      "black": {
        "$value": {"colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000"}
      }
    },
    "space": {
      "$type": "dimension",
      "0": {
        "$value": {"value": 0, "unit": "px"}
      },
      "1": {
        "$value": {"value": 4, "unit": "px"}
      },
      "3": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "6": {
        "$value": {"value": 1.5, "unit": "rem"}
      }
    },
    "radius": {
      "$type": "dimension",
      "none": {
        "$value": {"value": 0, "unit": "px"}
      },
      "md": {
        "$value": {"value": 8, "unit": "px"}
      }
    },
    "opacity": {
      "$type": "number",
      "opaque": {
        "$value": 1
      },
      "muted": {
        "$value": 0.8
      },
      "none": {
        "$value": 0
      }
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {"value": 150, "unit": "ms"}
      },
      "slow": {
        "$value": {
          "value": 0.4,
          "unit": "s"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": [
          "Montserrat",
          "sans-serif"
        ]
      },
      "weight-bold": {
        "$type": "fontWeight",
        "$value": "bold"
      },
      "scale": {
        "$type": "number",
        "$value": 1.25
      }
    },
    "angle": {
      "$type": "number",
      "$description": "Angles are numbers of degrees.",
      "tilt": {
        "$value": 22.5
      },
      "quarter": {
        "$value": 90
      }
    }
  },
  "color": {
    "$type": "color",
    "primary": {
      "$value": "{primitive.color.blue-500}"
    },
    "surface": {
      "$value": "{primitive.color.ink-900}"
    },
    "card": {
      "$value": "{primitive.color.ink-700}"
    },
    "text": {
      "$value": "{primitive.color.paper}"
    },
    "outline": {
      "$value": "{primitive.color.ink-500}"
    }
  },
  "space": {
    "$type": "dimension",
    "none": {
      "$value": "{primitive.space.0}"
    },
    "sm": {
      "$value": "{primitive.space.1}"
    },
    "md": {
      "$value": "{primitive.space.3}"
    },
    "lg": {
      "$value": "{primitive.space.6}"
    }
  },
  "opacity": {
    "$type": "number",
    "opaque": {
      "$value": "{primitive.opacity.opaque}"
    },
    "muted": {
      "$value": "{primitive.opacity.muted}"
    }
  },
  "motion": {
    "enter": {
      "$type": "transition",
      "$value": {
        "duration": "{primitive.duration.fast}",
        "delay": {"value": 0, "unit": "ms"},
        "timingFunction": "{primitive.easing.standard}"
      }
    },
    "slow": {
      "$type": "duration",
      "$value": "{primitive.duration.slow}"
    }
  },
  "text": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{primitive.font.family}",
        "fontSize": {"value": 14, "unit": "px"},
        "fontWeight": 400,
        "letterSpacing": {"value": 0, "unit": "px"},
        "lineHeight": 1.4
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{primitive.font.family}",
        "fontSize": {"value": 20, "unit": "px"},
        "fontWeight": "{primitive.font.weight-bold}",
        "letterSpacing": {"value": 1, "unit": "px"},
        "lineHeight": 1.2
      }
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "{primitive.radius.md}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "border": {
      "$type": "border",
      "$value": {
        "color": "{color.outline}",
        "width": {"value": 1, "unit": "px"},
        "style": "solid"
      }
    },
    "shadow": {
      "$type": "shadow",
      "$value": {
        "color": "{primitive.color.black}",
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 2, "unit": "px"},
        "blur": {"value": 8, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      }
    },
    "fill": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.card}",
          "position": 0
        },
        {
          "color": "{color.surface}",
          "position": 1
        }
      ]
    }
  },
  "screen": {
    "radius": {
      "$type": "dimension",
      "$value": "{primitive.radius.none}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{primitive.space.0}"
    }
  },
  "unknown": {
    "thing": {
      "$type": "somethingNew",
      "$value": "x"
    }
  }
}
