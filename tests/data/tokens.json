{
  "$description": "Test tokens for lvgl26, in the W3C Design Tokens format. Three tiers: primitive values, semantic roles, component tokens.",
  "primitive": {
    "color": {
      "$type": "color",
      "blue-500": {
        "$value": "#3366ff"
      },
      "ink-900": {
        "$value": "#0d1117"
      },
      "ink-700": {
        "$value": "#1b2430"
      },
      "ink-500": {
        "$value": "#30363d"
      },
      "paper": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9,
            0.93,
            0.95
          ],
          "hex": "#e6edf3"
        }
      },
      "black": {
        "$value": "#000000"
      }
    },
    "space": {
      "$type": "dimension",
      "0": {
        "$value": "0px"
      },
      "1": {
        "$value": "4px"
      },
      "3": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "6": {
        "$value": "1.5rem"
      }
    },
    "radius": {
      "$type": "dimension",
      "none": {
        "$value": "0px"
      },
      "md": {
        "$value": "8px"
      }
    },
    "opacity": {
      "$type": "number",
      "opaque": {
        "$value": 1
      },
      "muted": {
        "$value": 0.8
      },
      "none": {
        "$value": 0
      }
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "150ms"
      },
      "slow": {
        "$value": {
          "value": 0.4,
          "unit": "s"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": [
          "Montserrat",
          "sans-serif"
        ]
      },
      "weight-bold": {
        "$type": "fontWeight",
        "$value": "bold"
      },
      "scale": {
        "$type": "number",
        "$value": 1.25
      }
    }
  },
  "color": {
    "$type": "color",
    "primary": {
      "$value": "{primitive.color.blue-500}"
    },
    "surface": {
      "$value": "{primitive.color.ink-900}"
    },
    "card": {
      "$value": "{primitive.color.ink-700}"
    },
    "text": {
      "$value": "{primitive.color.paper}"
    },
    "outline": {
      "$value": "{primitive.color.ink-500}"
    }
  },
  "space": {
    "$type": "dimension",
    "none": {
      "$value": "{primitive.space.0}"
    },
    "sm": {
      "$value": "{primitive.space.1}"
    },
    "md": {
      "$value": "{primitive.space.3}"
    },
    "lg": {
      "$value": "{primitive.space.6}"
    }
  },
  "opacity": {
    "$type": "number",
    "opaque": {
      "$value": "{primitive.opacity.opaque}"
    },
    "muted": {
      "$value": "{primitive.opacity.muted}"
    }
  },
  "motion": {
    "enter": {
      "$type": "transition",
      "$value": {
        "duration": "{primitive.duration.fast}",
        "delay": "0ms",
        "timingFunction": "{primitive.easing.standard}"
      }
    },
    "slow": {
      "$type": "duration",
      "$value": "{primitive.duration.slow}"
    }
  },
  "text": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{primitive.font.family}",
        "fontSize": "14px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": 1.4
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{primitive.font.family}",
        "fontSize": "20px",
        "fontWeight": "{primitive.font.weight-bold}",
        "letterSpacing": "1px",
        "lineHeight": 1.2
      }
    }
  },
  "card": {
    "radius": {
      "$type": "dimension",
      "$value": "{primitive.radius.md}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "border": {
      "$type": "border",
      "$value": {
        "color": "{color.outline}",
        "width": "1px",
        "style": "solid"
      }
    },
    "shadow": {
      "$type": "shadow",
      "$value": {
        "color": "{primitive.color.black}",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "0px"
      }
    },
    "fill": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.card}",
          "position": 0
        },
        {
          "color": "{color.surface}",
          "position": 1
        }
      ]
    }
  },
  "screen": {
    "radius": {
      "$type": "dimension",
      "$value": "{primitive.radius.none}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{primitive.space.0}"
    }
  },
  "unknown": {
    "thing": {
      "$type": "somethingNew",
      "$value": "x"
    }
  }
}
