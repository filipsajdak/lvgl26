   "$value": "{color.white}"
  },
  "bg_opa": {
   "$type": "number",
   "$value": 1
  },
  "radius": {
   "$type": "dimension",
   "$value": {"value": 12, "unit": "px"}
  },
  "width": {
   "$type": "dimension",
   "$value": {"value": 140, "unit": "px"}
  },
