  "bg_color": {
   "$type": "color",
   "$value": {"colorSpace": "srgb", "components": [0.1686, 0.498, 1], "alpha": 0.502, "hex": "#2b7fff"}
  },
  "bg_opa": {
   "$type": "number",
   "$value": 1
  }
 },
