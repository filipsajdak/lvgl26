  "checked": {
   "text_color": {
    "$value": "{color.red}"
   }
  }
 },
 "pct": {
  "width": {
   "$type": "dimension",
   "$value": {"value": 100, "unit": "px"}
  },
  "height": {
   "$type": "dimension",
   "$value": {"value": 20, "unit": "px"}
  },
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "width": "50%",
    "height": "25%"
   }
  }
 },
 "alpha": {
