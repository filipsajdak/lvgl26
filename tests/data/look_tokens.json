   "$type": "dimension",
   "$value": {"value": 7, "unit": "px"}
  },
  "anim_duration": {
   "$type": "duration",
   "$value": {"value": 200, "unit": "ms"}
  }
 },
 "tile-inner": {
  "width": {
   "$type": "dimension",
   "$value": {"value": 64, "unit": "px"}
  },
  "height": {
   "$type": "dimension",
   "$value": {"value": 64, "unit": "px"}
  },
  "radius": {
   "$type": "dimension",
   "$value": {"value": 16, "unit": "px"}
  },
  "bg_color": {
   "$value": "{color.white}"
  },
  "bg_opa": {
   "$type": "number",
   "$value": 0.2
  }
