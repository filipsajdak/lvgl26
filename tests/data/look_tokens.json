{
 "$description": "Test tokens for lv::look: component groups named by the style properties they set.",
 "font": {
  "text": {
   "$type": "fontFamily",
   "$value": "Barlow"
  }
 },
 "text": {
  "$type": "typography",
  "label": {
   "$value": {
    "fontFamily": "{font.text}",
    "fontSize": {"value": 18, "unit": "px"},
    "fontWeight": 500,
    "lineHeight": 1.2,
    "letterSpacing": {"value": 0, "unit": "px"}
   }
  },
  "small": {
   "$value": {
    "fontFamily": "{font.text}",
    "fontSize": {"value": 12, "unit": "px"},
    "fontWeight": 500,
    "lineHeight": 1.2,
    "letterSpacing": {"value": 1, "unit": "px"}
   }
  }
 },
 "color": {
  "$type": "color",
  "white": {
   "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}
  },
  "blue": {
   "$value": {"colorSpace": "srgb", "components": [0.0824, 0.3647, 0.9882], "hex": "#155dfc"}
  },
  "gray": {
   "$value": {"colorSpace": "srgb", "components": [0.3843, 0.4549, 0.5569], "hex": "#62748e"}
  },
  "red": {
   "$value": {"colorSpace": "srgb", "components": [1, 0.1255, 0.3373], "hex": "#ff2056"}
  },
  "ink": {
   "$value": {"colorSpace": "srgb", "components": [0.1137, 0.1608, 0.2392], "hex": "#1d293d"}
  }
 },
 "elevation": {
  "card": {
   "$type": "shadow",
   "$value": {
    "color": {"colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000"},
    "offsetX": {"value": 0, "unit": "px"},
    "offsetY": {"value": 4, "unit": "px"},
    "blur": {"value": 12, "unit": "px"},
    "spread": {"value": 2, "unit": "px"}
   }
  }
 },
 "line": {
  "card": {
   "$type": "border",
   "$value": {
    "color": "{color.ink}",
    "width": {"value": 3, "unit": "px"},
    "style": "solid"
   }
  }
 },
 "motion": {
  "quick": {
   "$type": "transition",
   "$value": {
    "duration": {"value": 150, "unit": "ms"},
    "delay": {"value": 0, "unit": "ms"},
    "timingFunction": [
     0.4,
     0,
     0.2,
     1
    ]
   }
  }
 },
 "tile": {
  "bg_opa": {
   "$type": "number",
   "$value": 1
  },
  "radius": {
   "$type": "dimension",
   "$value": {"value": 24, "unit": "px"}
  },
  "width": {
   "$type": "dimension",
   "$value": {"value": 162, "unit": "px"}
  },
  "height": {
   "$type": "dimension",
   "$value": {"value": 192, "unit": "px"}
  },
  "pad_row": {
   "$type": "dimension",
   "$value": {"value": 10, "unit": "px"}
  },
  "text_color": {
   "$value": "{color.white}"
  },
  "text_font": {
   "$value": "{text.label}"
  },
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "layout": "flex",
    "flex_flow": "column",
    "flex_main_place": "center",
    "flex_cross_place": "center",
    "text_align": "center",
    "bg_grad_dir": "ver"
   }
  }
 },
 "status": {
  "text_color": {
   "$value": "{color.gray}"
  },
  "checked": {
   "text_color": {
    "$value": "{color.blue}"
   }
  }
