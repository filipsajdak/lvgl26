{
 "$description": "Groups that lv::look must refuse, one mistake each. tests/fail/look_*.cpp names them.",
 "color": {
  "$type": "color",
  "red": {
   "$value": {"colorSpace": "srgb", "components": [1, 0, 0], "hex": "#ff0000"}
  }
 },
 "typo": {
  "colour": {
   "$type": "color",
   "$value": {"colorSpace": "srgb", "components": [1, 0, 0], "hex": "#ff0000"}
  }
 },
 "wrongtype": {
  "radius": {
   "$type": "color",
   "$value": {"colorSpace": "srgb", "components": [1, 0, 0], "hex": "#ff0000"}
  }
 },
 "sizeone": {
  "size": {
   "$type": "dimension",
   "$value": {"value": 20, "unit": "px"}
  }
 },
 "font_for_color": {
  "text_color": {
   "$type": "typography",
   "$value": {
    "fontFamily": "Barlow",
    "fontSize": {"value": 12, "unit": "px"},
    "fontWeight": 500,
    "letterSpacing": {"value": 0, "unit": "px"},
    "lineHeight": 1
   }
  }
 },
 "layered": {
  "bg_opa": {
   "$type": "number",
   "$value": 1
  },
  "cheked": {
   "bg_color": {
    "$type": "color",
    "$value": {"colorSpace": "srgb", "components": [0, 1, 0], "hex": "#00ff00"}
   }
  }
 },
 "fine": {
  "radius": {
   "$type": "dimension",
   "$value": {"value": 4, "unit": "px"}
  }
 },
 "stringtoken": {
  "flex_flow": {
   "$type": "string",
   "$value": "row"
  }
 },
 "badenum": {
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "text_align": "centre"
   }
  }
 },
 "extunknown": {
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "colour": "red"
   }
  }
 },
 "extpad": {
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "pad_all": "50%"
   }
  }
 },
 "exttext": {
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "radius": "big"
   }
  }
 },
 "extpercent": {
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "width": "5x%"
   }
  }
 },
 "percentvalue": {
  "width": {
   "$type": "dimension",
   "$value": "50%"
  }
 },
 "extends": {
  "$extends": "{fine}",
  "radius": {
   "$type": "dimension",
   "$value": {"value": 3, "unit": "px"}
  }
 },
 "alpharadius": {
  "radius": {
   "$type": "color",
   "$value": {"colorSpace": "srgb", "components": [1, 0, 0], "alpha": 0.502, "hex": "#ff0000"}
  }
 },
 "layeredin": {
  "checked": {
   "extra": {
    "bg_color": {
     "$type": "color",
     "$value": {"colorSpace": "srgb", "components": [0, 0, 1], "hex": "#0000ff"}
    }
   }
  }
 },
 "queue": {
  "card": {
   "radius": {
    "$type": "dimension",
    "$value": {"value": 4, "unit": "px"}
   }
  },
  "details": {
   "radius": {
    "$type": "dimension",
    "$value": {"value": 2, "unit": "px"}
   }
  }
 }
}