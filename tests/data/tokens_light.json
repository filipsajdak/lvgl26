{
  "$description": "Test tokens for lvgl26, in the W3C Design Tokens format.",
  "color": {
    "$type": "color",
    "palette": {
      "blue-500": { "$value": "#3366ff" },
      "ink-900": { "$value": "#f6f8fa" },
      "ink-700": { "$value": "#ffffff" },
      "paper": { "$value": { "colorSpace": "srgb", "components": [0.9, 0.93, 0.95], "hex": "#1f2328" } }
    },
    "primary": { "$value": "{color.palette.blue-500}" },
    "surface": { "$value": "{color.palette.ink-900}" },
    "card": { "$value": "{color.palette.ink-700}" },
    "text": { "$value": "{color.palette.paper}" }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": "1.5rem" }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": "20px" },
    "pill": { "$value": "{space.lg}" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "150ms" },
    "slow": { "$type": "duration", "$value": { "value": 0.4, "unit": "s" } }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Montserrat" },
    "weight": { "$type": "fontWeight", "$value": "bold" },
    "scale": { "$type": "number", "$value": 1.25 }
  },
  "elevation": {
    "card": { "$type": "shadow", "$value": { "color": "#00000080", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px" } }
  }
}
