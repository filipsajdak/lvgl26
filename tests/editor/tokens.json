{
  "$description": "Tokens of every kind, for tests/editor/api_uses.cpp.",
  "color": {
    "$type": "color",
    "ink": {
      "$value": {"colorSpace": "srgb", "components": [0.0627, 0.1255, 0.1882], "hex": "#102030"},
      "$description": "Text and lines."
    },
    "accent": {
      "$value": "{color.ink}"
    }
  },
  "space": {
    "$type": "dimension",
    "gap": {
      "$value": {"value": 8, "unit": "px"}
    },
    "2xl": {
      "$value": {"value": 32, "unit": "px"}
    }
  },
  "opacity": {
    "half": {
      "$type": "number",
      "$value": 0.5
    }
  },
  "time": {
    "quick": {
      "$type": "duration",
      "$value": {"value": 150, "unit": "ms"}
    }
  },
  "motion": {
    "fall": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    }
  },
  "font": {
    "text": {
      "$type": "fontFamily",
      "$value": "Barlow"
    }
  },
  "text": {
    "$type": "typography",
    "label": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": {"value": 16, "unit": "px"},
        "fontWeight": 500,
        "letterSpacing": {"value": 0, "unit": "px"},
        "lineHeight": 1.3
      }
    }
  },
  "card": {
    "border": {
      "$type": "border",
      "$value": {
        "color": "{color.ink}",
        "width": {"value": 1, "unit": "px"},
        "style": "solid"
      }
    },
    "shadow": {
      "$type": "shadow",
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000"},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 2, "unit": "px"},
        "blur": {"value": 4, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      }
    },
    "fade": {
      "$type": "transition",
      "$value": {
        "duration": {"value": 150, "unit": "ms"},
        "delay": {"value": 0, "unit": "ms"},
        "timingFunction": [
          0,
          0,
          1,
          1
        ]
      }
    }
  },
  "tile": {
    "radius": {
      "$type": "dimension",
      "$value": {"value": 24, "unit": "px"}
    },
    "bg_opa": {
      "$type": "number",
      "$value": 1
    },
    "text_font": {
      "$value": "{text.label}"
    },
    "pressed": {
      "bg_opa": {
        "$type": "number",
        "$value": 0.8
      }
    }
  },
  "tile-print": {
    "bg_color": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0.1686, 0.498, 1], "hex": "#2b7fff"}
    }
  },
  "tile-scan": {
    "bg_color": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0, 0.7373, 0.4902], "hex": "#00bc7d"}
    }
  },
  "tile-ink-level": {
    "bg_color": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0, 0.7569, 0.8863], "hex": "#00c1e2"}
    }
  }
}