{
  "$description": "Tokens of every kind, for tests/editor/api_uses.cpp.",
  "color": {
    "$type": "color",
    "ink": { "$value": "#102030", "$description": "Text and lines." },
    "accent": { "$value": "{color.ink}" }
  },
  "space": {
    "$type": "dimension",
    "gap": { "$value": "8px" },
    "2xl": { "$value": "32px" }
  },
  "opacity": { "half": { "$type": "number", "$value": 0.5 } },
  "time": { "quick": { "$type": "duration", "$value": "150ms" } },
  "motion": { "fall": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] } },
  "font": { "text": { "$type": "fontFamily", "$value": "Barlow" } },
  "text": {
    "$type": "typography",
    "label": {
      "$value": { "fontFamily": "{font.text}", "fontSize": "16px", "fontWeight": 500, "letterSpacing": "0px", "lineHeight": 1.3 }
    }
  },
  "card": {
    "border": { "$type": "border", "$value": { "color": "{color.ink}", "width": "1px", "style": "solid" } },
    "shadow": {
      "$type": "shadow",
      "$value": { "color": "#000000", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" }
    },
    "fade": { "$type": "transition", "$value": { "duration": "150ms", "delay": "0ms", "timingFunction": [0, 0, 1, 1] } }
  }
}
