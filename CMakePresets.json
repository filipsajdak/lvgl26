    },
    {
      "name": "host-v10-asan",
      "configurePreset": "host-v10-asan"
    },
    {
      "name": "host-v96-tsan",
      "configurePreset": "host-v96-tsan"
    },
    {
      "name": "host-v96-analyze",
      "configurePreset": "host-v96-analyze"
    },
    {
