{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "host-v96",
      "inherits": "host",
      "cacheVariables": {
        "LVGL26_LVGL_REF": "v9.6.0"
      }
    },
    {
      "name": "host-v10",
      "inherits": "host",
      "cacheVariables": {
        "LVGL26_LVGL_REF": "53819fe4fd3f3a767420743cbfdb2816f3928931"
      }
    },
    {
      "name": "host-v96-asan",
      "inherits": "host-v96",
      "cacheVariables": {
        "LVGL26_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "host-v10-asan",
      "inherits": "host-v10",
      "cacheVariables": {
        "LVGL26_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "host-v96-tsan",
      "inherits": "host-v96",
      "cacheVariables": {
        "LVGL26_SANITIZE": "thread"
      }
    },
    {
      "name": "host-v96-analyze",
      "inherits": "host-v96",
      "cacheVariables": {
        "LVGL26_ANALYZE": "ON"
      }
    },
    {
      "name": "host-v96-coverage",
      "inherits": "host-v96",
      "cacheVariables": {
        "LVGL26_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-v96",
      "configurePreset": "host-v96"
    },
    {
