{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The tokens of the icons example: text in Barlow, icons in Phosphor, two colours.",
  "font": {
    "text": { "$type": "fontFamily", "$value": "Barlow" },
    "icon": { "$type": "fontFamily", "$value": "Phosphor" }
  },
  "color": {
    "$type": "color",
    "ink": {
      "$value": {"hex": "#2b2f36", "colorSpace": "srgb", "components": [0.1686, 0.1843, 0.2118]}
    },
    "accent": {
      "$value": {"hex": "#c4561a", "colorSpace": "srgb", "components": [0.7686, 0.3373, 0.102]}
    }
  },
  "text": {
    "$type": "typography",
    "label": {
      "$value": { "fontFamily": "{font.text}", "fontSize": {"value": 20, "unit": "px"}, "fontWeight": 500, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1.3 }
    }
  },
  "icon": {
    "$type": "typography",
    "md": {
      "$value": { "fontFamily": "{font.icon}", "fontSize": {"value": 28, "unit": "px"}, "fontWeight": 700, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1 }
    }
  }
}
