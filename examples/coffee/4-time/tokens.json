    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "column",
        "width": "100%"
      }
    }
  },
  "fact": {
    "border_width": {"$value": "{stroke.rule}"},
    "border_color": {"$value": "{color.line}"},
    "pad_bottom": {"$value": "{space.2}"},
    "$extensions": {
