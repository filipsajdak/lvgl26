{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The design of step 4 of the coffee machine tutorial (docs/research/tutorial-coffee-draft.md), after the mock-up in design/coffee: values first, then one group for each look. A look's entries are named for the style properties they set.",
  "color": {
    "$type": "color",
    "ground": {"$value": {"hex": "#ffffff", "colorSpace": "srgb", "components": [1, 1, 1]}},
    "surface": {"$value": {"hex": "#ecedf0", "colorSpace": "srgb", "components": [0.9255, 0.9294, 0.9412]}},
    "surface-raised": {"$value": {"hex": "#dcdee3", "colorSpace": "srgb", "components": [0.8627, 0.8706, 0.8902]}},
    "line": {"$value": {"hex": "#c4c7cf", "colorSpace": "srgb", "components": [0.7686, 0.7804, 0.8118]}},
    "line-strong": {"$value": {"hex": "#5f626c", "colorSpace": "srgb", "components": [0.3725, 0.3843, 0.4235]}},
    "reading": {"$value": {"hex": "#0a0a0c", "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0471]}},
    "muted": {"$value": {"hex": "#4a4d57", "colorSpace": "srgb", "components": [0.2902, 0.302, 0.3412]}},
    "active": {"$value": {"hex": "#0a0a0c", "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0471]}},
    "on-active": {"$value": {"hex": "#d4ff3a", "colorSpace": "srgb", "components": [0.8314, 1, 0.2275]}}
  },
  "space": {
    "$type": "dimension",
    "none": {"$value": {"value": 0, "unit": "px"}},
    "1": {"$value": {"value": 4, "unit": "px"}},
    "2": {"$value": {"value": 8, "unit": "px"}},
    "3": {"$value": {"value": 12, "unit": "px"}},
    "4": {"$value": {"value": 16, "unit": "px"}},
    "6": {"$value": {"value": 24, "unit": "px"}}
  },
  "size": {
    "$type": "dimension",
    "screen-width": {"$value": {"value": 480, "unit": "px"}, "$description": "The machine's screen, landscape."},
    "screen-height": {"$value": {"value": 320, "unit": "px"}},
    "target": {"$value": {"value": 48, "unit": "px"}, "$description": "The smallest touch target: every control is at least this in both directions."},
    "photo": {"$value": {"value": 72, "unit": "px"}, "$description": "The photo of a drink on its tile: 1.5 x target."},
    "button": {"$value": {"value": 144, "unit": "px"}, "$description": "The narrowest button with a word: 3 x target."},
    "ring": {"$value": {"value": 192, "unit": "px"}, "$description": "The progress ring of the brewing: 4 x target."},
    "hero": {"$value": {"value": 144, "unit": "px"}, "$description": "The photo of the finished drink: 3 x target."},
    "steam": {"$value": {"value": 96, "unit": "px"}, "$description": "A wisp of steam: 2 x target."}
  },
  "stroke": {
    "$type": "dimension",
    "bar": {"$value": {"value": 4, "unit": "px"}, "$description": "The border of a control that has no fill."},
    "track": {"$value": {"value": 8, "unit": "px"}, "$description": "A segment of the strength."},
    "ring": {"$value": {"value": 16, "unit": "px"}, "$description": "The progress ring."},
    "rule": {"$value": {"value": 2, "unit": "px"}, "$description": "The line under a row of facts: half of stroke.bar."}
  },
  "opacity": {
    "$type": "number",
    "disabled": {"$value": 0.35, "$description": "A control that cannot be used now."},
    "quiet": {"$value": 0.8, "$description": "Text beside a value that names its unit, such as the currency."},
    "steam": {"$value": 0.5, "$description": "A wisp of steam at its thickest."},
    "hidden": {"$value": 0, "$description": "What is not seen yet: a wisp before it rises."}
  },
  "duration": {
    "$type": "duration",
    "enter": {"$value": {"value": 220, "unit": "ms"}, "$description": "A page that comes into view."},
    "settle": {"$value": {"value": 480, "unit": "ms"}, "$description": "Something that lands, with a small overshoot."},
    "steam": {"$value": {"value": 5200, "unit": "ms"}, "$description": "One rise of a wisp of steam, which loops."}
  },
  "ease": {
    "$type": "cubicBezier",
    "out": {"$value": [0.2, 0.7, 0.2, 1], "$description": "What arrives: fast at first, then slowly to rest."},
    "back": {"$value": [0.34, 1.56, 0.64, 1], "$description": "What lands: a little past its place, then back."},
    "in-out": {"$value": [0.42, 0, 0.58, 1], "$description": "What loops: slow at both ends."}
  },
  "layout": {
    "$type": "dimension",
    "margin": {"$value": "{space.6}", "$description": "Left and right of every screen."},
    "gap": {"$value": "{space.3}", "$description": "Between blocks, and between the content and the footer."},
    "pad": {"$value": "{space.4}", "$description": "Inside a tile."},
    "dot": {"$value": "{space.3}", "$description": "A dot of the step: a square."},
    "header-height": {"$value": "{size.target}", "$description": "The header: target."},
    "footer-height": {"$value": {"value": 64, "unit": "px"}, "$description": "The footer: target + space-4."},
    "steam-1-x": {"$value": {"value": 3, "unit": "px"}, "$description": "The first wisp, from the left of the photo: 2% of size.hero."},
    "steam-2-x": {"$value": {"value": 26, "unit": "px"}, "$description": "The second wisp: 18% of size.hero."},
    "steam-3-x": {"$value": {"value": 14, "unit": "px"}, "$description": "The third wisp: 10% of size.hero."},
    "steam-y": {"$value": {"value": -30, "unit": "px"}, "$description": "The top of a wisp, whose bottom is 54% of size.hero above the photo's bottom: 144 - 78 - 96."}
  },
  "font": {
    "$type": "fontFamily",
    "display": {"$value": "Barlow Condensed"},
    "text": {"$value": "Barlow"}
  },
  "text": {
    "$type": "typography",
    "title": {"$value": {"fontFamily": "{font.text}", "fontSize": {"value": 24, "unit": "px"}, "fontWeight": 600, "letterSpacing": {"value": 2, "unit": "px"}, "lineHeight": 1.1667}},
    "label": {"$value": {"fontFamily": "{font.text}", "fontSize": {"value": 16, "unit": "px"}, "fontWeight": 700, "letterSpacing": {"value": 1, "unit": "px"}, "lineHeight": 1.25}},
    "price": {"$value": {"fontFamily": "{font.display}", "fontSize": {"value": 24, "unit": "px"}, "fontWeight": 700, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1.1667}},
    "currency": {"$value": {"fontFamily": "{font.text}", "fontSize": {"value": 13, "unit": "px"}, "fontWeight": 600, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1.3846}},
    "note": {"$value": {"fontFamily": "{font.text}", "fontSize": {"value": 13, "unit": "px"}, "fontWeight": 700, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1.3846}},
    "caption": {"$value": {"fontFamily": "{font.text}", "fontSize": {"value": 13, "unit": "px"}, "fontWeight": 500, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1.3846}},
    "sign": {"$value": {"fontFamily": "{font.text}", "fontSize": {"value": 24, "unit": "px"}, "fontWeight": 700, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1}},
    "numeral": {"$value": {"fontFamily": "{font.display}", "fontSize": {"value": 40, "unit": "px"}, "fontWeight": 700, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1}},
    "body": {"$value": {"fontFamily": "{font.text}", "fontSize": {"value": 16, "unit": "px"}, "fontWeight": 500, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1.375}},
    "overline": {"$value": {"fontFamily": "{font.text}", "fontSize": {"value": 13, "unit": "px"}, "fontWeight": 700, "letterSpacing": {"value": 1, "unit": "px"}, "lineHeight": 1.3846}},
    "numeral-large": {"$value": {"fontFamily": "{font.display}", "fontSize": {"value": 72, "unit": "px"}, "fontWeight": 700, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 0.9167}},
    "headline": {"$value": {"fontFamily": "{font.display}", "fontSize": {"value": 40, "unit": "px"}, "fontWeight": 700, "letterSpacing": {"value": 1, "unit": "px"}, "lineHeight": 1}, "$description": "The name of the finished drink: numeral's face, with the tracking of a label."}
  },
  "page": {
    "bg_color": {"$value": "{color.ground}"},
    "bg_opa": {"$type": "number", "$value": 1},
    "pad_left": {"$value": "{layout.margin}"},
    "pad_right": {"$value": "{layout.margin}"},
    "text_color": {"$value": "{color.reading}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "column"
      }
    }
  },
  "header": {
    "height": {"$value": "{layout.header-height}"},
    "pad_column": {"$value": "{layout.gap}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_cross_place": "center",
        "flex_track_place": "center"
      }
    }
  },
  "title": {
    "flex_grow": {"$type": "number", "$value": 1}
  },
  "dots": {
    "pad_column": {"$value": "{space.2}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_cross_place": "center",
        "flex_track_place": "center"
      }
    }
  },
  "dot": {
    "width": {"$value": "{layout.dot}"},
    "height": {"$value": "{layout.dot}"},
    "bg_color": {"$value": "{color.line}"},
    "bg_opa": {"$type": "number", "$value": 1}
  },
  "dot-on": {
    "bg_color": {"$value": "{color.active}"}
  },
  "step": {
    "pad_left": {"$value": "{space.1}"},
    "text_color": {"$value": "{color.muted}"}
  },
  "tiles": {
    "flex_grow": {"$type": "number", "$value": 1},
    "pad_row": {"$value": "{layout.gap}"},
    "pad_bottom": {"$value": "{layout.gap}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "column"
      }
    }
  },
  "tile-row": {
    "flex_grow": {"$type": "number", "$value": 1},
    "pad_column": {"$value": "{layout.gap}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row"
      }
    }
  },
  "tile": {
    "flex_grow": {"$type": "number", "$value": 1},
    "bg_color": {"$value": "{color.surface}"},
    "bg_opa": {"$type": "number", "$value": 1},
    "radius": {"$value": "{space.none}"},
    "shadow_width": {"$value": "{space.none}"},
    "pad_left": {"$value": "{layout.pad}"},
    "pad_right": {"$value": "{layout.pad}"},
    "pad_top": {"$value": "{space.none}"},
    "pad_bottom": {"$value": "{space.none}"},
    "pad_column": {"$value": "{layout.pad}"},
    "text_color": {"$value": "{color.reading}"},
    "pressed": {
      "bg_color": {"$value": "{color.surface-raised}"},
      "color_filter_opa": {"$type": "number", "$value": 0}
    },
    "checked": {
      "bg_color": {"$value": "{color.active}"},
      "text_color": {"$value": "{color.on-active}"}
    },
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_cross_place": "center",
        "flex_track_place": "center",
        "height": "100%"
      }
    }
  },
  "tile-text": {
    "pad_row": {"$value": "{space.1}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "column"
      }
    }
  },
  "price-row": {
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_cross_place": "end"
      }
    }
  },
  "currency": {
    "pad_left": {"$value": "{space.1}"},
    "text_opa": {"$value": "{opacity.quiet}"}
  },
  "footer": {
    "height": {"$value": "{layout.footer-height}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_main_place": "space_between",
        "flex_cross_place": "start"
      }
    }
  },
  "primary": {
    "height": {"$value": "{size.target}"},
    "min_width": {"$value": "{size.button}"},
    "pad_left": {"$value": "{space.6}"},
    "pad_right": {"$value": "{space.6}"},
    "bg_color": {"$value": "{color.active}"},
    "bg_opa": {"$type": "number", "$value": 1},
    "radius": {"$value": "{space.none}"},
    "shadow_width": {"$value": "{space.none}"},
    "text_color": {"$value": "{color.on-active}"},
    "pressed": {
      "bg_color": {"$value": "{color.surface-raised}"},
      "text_color": {"$value": "{color.reading}"},
      "color_filter_opa": {"$type": "number", "$value": 0}
    },
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_main_place": "center",
        "flex_cross_place": "center",
        "flex_track_place": "center"
      }
    }
  },
  "cup": {
    "flex_grow": {"$type": "number", "$value": 1},
    "pad_column": {"$value": "{space.6}"},
    "pad_bottom": {"$value": "{layout.gap}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row"
      }
    }
  },
  "fields": {
    "flex_grow": {"$type": "number", "$value": 1},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "column",
        "flex_main_place": "space_between"
      }
    }
  },
  "field": {
    "pad_row": {"$value": "{space.1}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "column",
        "width": "100%"
      }
    }
  },
  "field-top": {
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_main_place": "space_between",
        "flex_cross_place": "end",
        "width": "100%"
      }
    }
  },
  "overline": {
    "text_color": {"$value": "{color.muted}"}
  },
  "stepper": {
    "height": {"$value": "{size.target}"},
    "pad_column": {"$value": "{layout.gap}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_cross_place": "center",
        "flex_track_place": "center",
        "width": "100%"
      }
    }
  },
  "square": {
    "width": {"$value": "{size.target}"},
    "height": {"$value": "{size.target}"},
    "bg_opa": {"$type": "number", "$value": 0},
    "border_color": {"$value": "{color.line-strong}"},
    "border_width": {"$value": "{stroke.bar}"},
    "radius": {"$value": "{space.none}"},
    "shadow_width": {"$value": "{space.none}"},
    "text_color": {"$value": "{color.reading}"},
    "pressed": {
      "bg_color": {"$value": "{color.surface-raised}"},
      "bg_opa": {"$type": "number", "$value": 1},
      "color_filter_opa": {"$type": "number", "$value": 0}
    },
    "disabled": {
      "opa": {"$value": "{opacity.disabled}"}
    },
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_main_place": "center",
        "flex_cross_place": "center",
        "flex_track_place": "center"
      }
    }
  },
  "segments": {
    "flex_grow": {"$type": "number", "$value": 1},
    "pad_column": {"$value": "{space.1}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_cross_place": "center",
        "flex_track_place": "center"
      }
    }
  },
  "segment": {
    "flex_grow": {"$type": "number", "$value": 1},
    "height": {"$value": "{stroke.track}"},
    "bg_color": {"$value": "{color.line}"},
    "bg_opa": {"$type": "number", "$value": 1},
    "checked": {
      "bg_color": {"$value": "{color.active}"}
    }
  },
  "value": {
    "flex_grow": {"$type": "number", "$value": 1},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_main_place": "center",
        "flex_cross_place": "end",
        "flex_track_place": "center"
      }
    }
  },
  "unit": {
    "pad_left": {"$value": "{space.1}"},
    "text_color": {"$value": "{color.muted}"}
  },
  "summary": {
    "width": {"$value": "{size.button}"},
    "bg_color": {"$value": "{color.surface}"},
    "bg_opa": {"$type": "number", "$value": 1},
    "pad_top": {"$value": "{space.3}"},
    "pad_left": {"$value": "{layout.pad}"},
    "pad_right": {"$value": "{layout.pad}"},
    "pad_bottom": {"$value": "{layout.pad}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "column"
      }
    }
  },
  "photo-box": {
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_main_place": "center",
        "width": "100%"
      }
    }
  },
  "summary-name": {
    "pad_top": {"$value": "{space.1}"}
  },
  "spacer": {
    "flex_grow": {"$type": "number", "$value": 1}
  },
  "beans": {
    "text_color": {"$value": "{color.muted}"}
  },
  "ghost": {
    "height": {"$value": "{size.target}"},
    "pad_left": {"$value": "{space.none}"},
    "pad_right": {"$value": "{space.4}"},
    "bg_opa": {"$type": "number", "$value": 0},
    "radius": {"$value": "{space.none}"},
    "shadow_width": {"$value": "{space.none}"},
    "text_color": {"$value": "{color.reading}"},
    "pressed": {
      "bg_color": {"$value": "{color.surface-raised}"},
      "bg_opa": {"$type": "number", "$value": 1},
      "color_filter_opa": {"$type": "number", "$value": 0}
    },
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_main_place": "center",
        "flex_cross_place": "center",
        "flex_track_place": "center"
      }
    }
  },
  "brew": {
    "flex_grow": {"$type": "number", "$value": 1},
    "pad_column": {"$value": "{space.6}"},
    "pad_bottom": {"$value": "{layout.gap}"},
    "$extensions": {
      "io.github.filipsajdak.lvgl26": {
        "layout": "flex",
        "flex_flow": "row",
        "flex_cross_place": "center",
        "flex_track_place": "center"
      }
    }
  },
  "ring-box": {
    "width": {"$value": "{size.ring}"},
    "height": {"$value": "{size.ring}"}
  },
  "ring": {
    "bg_opa": {"$type": "number", "$value": 0},
    "pad_left": {"$value": "{space.none}"},
    "pad_right": {"$value": "{space.none}"},
    "pad_top": {"$value": "{space.none}"},
    "pad_bottom": {"$value": "{space.none}"},
    "arc_width": {"$value": "{stroke.ring}"},
    "arc_color": {"$value": "{color.line}"},
    "indicator": {
      "arc_width": {"$value": "{stroke.ring}"},
      "arc_color": {"$value": "{color.active}"}
    },
    "knob": {
