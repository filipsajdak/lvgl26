{
  "$description": "The typography of the fonts example: three roles, two files of one family.",
  "font": {
    "text": { "$type": "fontFamily", "$value": "Barlow" },
    "display": { "$type": "fontFamily", "$value": "Barlow Condensed" }
  },
  "text": {
    "$type": "typography",
    "label": {
      "$value": { "fontFamily": "{font.text}", "fontSize": "16px", "fontWeight": 500, "letterSpacing": "0px", "lineHeight": 1.3 }
    },
    "title": {
      "$value": { "fontFamily": "{font.text}", "fontSize": "28px", "fontWeight": 500, "letterSpacing": "0px", "lineHeight": 1.2 }
    },
    "numeral": {
      "$value": { "fontFamily": "{font.display}", "fontSize": "96px", "fontWeight": 600, "letterSpacing": "0px", "lineHeight": 1 }
    }
  }
}
