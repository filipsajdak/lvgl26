{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Design tokens of the get_started examples. The values are the ones LVGL's C examples use.",
  "opacity": {
    "$type": "number",
    "opaque": {
      "$value": 1
    },
    "faint": {
      "$value": 0.2
    }
  },
  "screen": {
    "$type": "color",
    "background": {
      "$value": {"colorSpace": "srgb", "components": [0, 0.2275, 0.3412], "hex": "#003a57"}
    },
    "text": {
      "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}
    }
  },
  "button": {
    "fill-top": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0.9333, 0.9333, 0.9333], "hex": "#eeeeee"}
    },
    "fill-bottom": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0.6196, 0.6196, 0.6196], "hex": "#9e9e9e"}
    },
    "pressed-top": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0.7412, 0.7412, 0.7412], "hex": "#bdbdbd"}
    },
    "pressed-bottom": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0.4588, 0.4588, 0.4588], "hex": "#757575"}
    },
    "danger-top": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0.9569, 0.2627, 0.2118], "hex": "#f44336"}
    },
    "danger-bottom": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [1, 0.8039, 0.8235], "hex": "#ffcdd2"}
    },
    "border": {
      "$type": "border",
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000"},
        "width": {"value": 2, "unit": "px"},
        "style": "solid"
      }
    },
    "border-opacity": {
      "$type": "number",
      "$value": "{opacity.faint}"
    },
    "text": {
      "$type": "color",
      "$value": {"colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000"}
    },
    "radius": {
      "$type": "dimension",
      "$value": {"value": 10, "unit": "px"}
    },
    "pill-radius": {
      "$type": "dimension",
      "$value": {"value": 25, "unit": "px"}
    }
  }
}
