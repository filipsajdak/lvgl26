{
  "$description": "Design tokens of the get_started examples. The values are the ones LVGL's C examples use.",
  "opacity": {
    "$type": "number",
    "opaque": {
      "$value": 1
    },
    "faint": {
      "$value": 0.2
    }
  },
  "screen": {
    "$type": "color",
    "background": {
      "$value": "#003a57"
    },
    "text": {
      "$value": "#ffffff"
    }
  },
  "button": {
    "fill-top": {
      "$type": "color",
      "$value": "#eeeeee"
    },
    "fill-bottom": {
      "$type": "color",
      "$value": "#9e9e9e"
    },
    "pressed-top": {
      "$type": "color",
      "$value": "#bdbdbd"
    },
    "pressed-bottom": {
      "$type": "color",
      "$value": "#757575"
    },
    "danger-top": {
      "$type": "color",
      "$value": "#f44336"
    },
    "danger-bottom": {
      "$type": "color",
      "$value": "#ffcdd2"
    },
    "border": {
      "$type": "border",
      "$value": {
        "color": "#000000",
        "width": "2px",
        "style": "solid"
      }
    },
    "border-opacity": {
      "$type": "number",
      "$value": "{opacity.faint}"
    },
    "text": {
      "$type": "color",
      "$value": "#000000"
    },
    "radius": {
      "$type": "dimension",
      "$value": "10px"
    },
    "pill-radius": {
      "$type": "dimension",
      "$value": "25px"
    }
  }
}
