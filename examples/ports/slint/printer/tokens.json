  "solid": {
    "$type": "number",
    "$value": 1
  },
  "tint": {
    "$type": "number",
    "$value": 1
  },
  "header": {
    "background": {
      "$type": "color",
      "$value": "#f8fafc"
    },
    "separator": {
      "$type": "color",
      "$value": "#cad5e2"
    }
  },
  "button": {
    "primary": {
      "$type": "color",
      "$value": "#2b7fff"
    },
    "destructive": {
      "$type": "color",
      "$value": "#fa2c37"
    },
    "radius": {
      "$type": "dimension",
      "$value": "14px"
    },
    "color": {
      "$type": "color",
      "from": {
        "$value": "#ff3b30"
      },
      "to": {
        "$value": "#af52de"
      }
    },
    "gray": {
      "$type": "color",
      "from": {
        "$value": "#99a1af"
      },
      "to": {
        "$value": "#4a5565"
      }
    }
  },
  "spinbox": {
    "button": {
      "$type": "color",
      "$value": "#277aff"
    },
    "text": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "radius": {
      "$type": "dimension",
      "$value": "14px"
    }
  },
  "control": {
    "border": {
      "$type": "color",
      "$value": "#e2e8f0"
    },
    "background": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "radius": {
      "$type": "dimension",
      "$value": "14px"
    },
    "active": {
      "$type": "color",
      "$value": "#ffedd4"
    },
    "active_text": {
      "$type": "color",
      "$value": "#f54900"
    },
    "line": {
      "$type": "dimension",
      "$value": "2px"
    },
    "thin": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "motion": {
    "slide": {
      "$type": "cubicBezier",
      "$description": "CSS ease: how a page slides in and out.",
      "$value": [
        0.25,
        0.1,
        0.25,
        1.0
      ]
    },
    "ink": {
      "$type": "cubicBezier",
      "$description": "CSS ease-in-out: how the ink levels rise.",
      "$value": [
        0.42,
        0,
        0.58,
        1.0
      ]
    },
    "ink_in": {
      "$type": "cubicBezier",
      "$description": "CSS ease-in.",
      "$value": [
        0.42,
        0,
        1.0,
        1.0
      ]
    },
    "slide_time": {
      "$type": "duration",
      "$value": "125ms"
    },
    "ink_time": {
      "$type": "duration",
      "$value": "750ms"
    },
    "ink_delay": {
      "$type": "duration",
      "$value": "30ms"
    }
  },
  "space": {
    "gap": {
      "$type": "dimension",
      "$value": "8px"
    },
    "card": {
      "$type": "dimension",
      "$value": "16px"
    },
    "edge": {
      "$type": "dimension",
      "$value": "24px"
    },
    "row": {
      "$type": "dimension",
      "$value": "12px"
    },
    "none": {
      "$type": "dimension",
      "$value": "0px"
    }
  },
  "clear": {
    "$type": "number",
    "$value": 0
  }
}
