{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Design tokens of the printer panel, theme Gradient, after the Slint printer demo (MIT, design by Matthias Grimme). Colors and sizes are the original's.",
  "font": {
    "text": {
      "$type": "fontFamily",
      "$value": "Inter 24pt"
    }
  },
  "text": {
    "$type": "typography",
    "title": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "24px",
        "fontWeight": 500,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "20px",
        "fontWeight": 500,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "18px",
        "fontWeight": 500,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "16px",
        "fontWeight": 500,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "detail": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "15px",
        "fontWeight": 500,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "small": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "14px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "status": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "12px",
        "fontWeight": 400,
        "letterSpacing": "1px",
        "lineHeight": 1.2
      }
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "18px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    }
  },
  "window": {
    "background": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "radius": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "color": {
    "primary": {
      "$type": "color",
      "$value": "#0e133f"
    },
    "secondary": {
      "$type": "color",
      "$value": "#e2e8f0"
    },
    "neutral": {
      "$type": "color",
      "$value": "#bdc0d1"
    },
    "foreground": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "muted": {
      "$type": "color",
      "$value": "#c1c3ca"
    }
  },
  "sidebar": {
    "background": {
      "$type": "color",
      "$value": "#0e172b"
    },
    "active": {
      "$type": "color",
      "$value": "#1d293d"
    },
    "icon": {
      "$type": "color",
      "$value": "#90a1b9"
    },
    "icon_active": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "icon_radius": {
      "$type": "dimension",
      "$value": "16px"
    },
    "separator": {
      "$type": "color",
      "$value": "#0e172b"
    }
  },
  "ink": {
    "yellow": {
      "$type": "color",
      "$value": "#ffff00"
    },
    "cyan": {
      "$type": "color",
      "$value": "#00ffff"
