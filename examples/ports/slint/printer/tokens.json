    "magenta": {
      "$type": "color",
      "$value": "#ff00ff"
    },
    "black": {
      "$type": "color",
      "$value": "#000000"
    },
    "pill": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "pill_opa": {
      "$type": "number",
      "$value": 0.9
    },
    "accent": {
      "$type": "color",
      "$value": "#6284ff"
    },
    "text": {
      "$type": "color",
      "$value": "#1d293d"
    },
    "radius": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "label": {
    "primary": {
      "$type": "color",
      "$value": "#1d293d"
    },
    "secondary": {
      "$type": "color",
      "$value": "#155dfc"
    },
    "tertiary": {
      "$type": "color",
      "$value": "#62748e"
    },
    "on_tile": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "on_button": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "detail": {
      "$type": "color",
      "$value": "#122f7b"
    },
    "value": {
      "$type": "color",
      "$value": "#c1c3ca"
    }
  },
  "tile": {
