      "$type": "dimension",
      "$value": "10px"
    },
    "radius": {
      "$type": "dimension",
      "$value": "24px"
    },
    "inner_radius": {
      "$type": "dimension",
      "$value": "16px"
    },
    "inner": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "inner_strength": {
      "$type": "number",
      "$value": 0.2
    },
    "print": {
      "$type": "color",
      "from": {
        "$value": "#2b7fff"
      },
      "to": {
        "$value": "#155dfc"
      }
    },
    "scan": {
      "$type": "color",
      "from": {
        "$value": "#00bc7d"
      },
      "to": {
        "$value": "#009966"
      }
    },
    "copy": {
      "$type": "color",
      "from": {
        "$value": "#ff2056"
      },
      "to": {
        "$value": "#fd3d6d"
      }
    },
    "usb": {
      "$type": "color",
      "from": {
        "$value": "#ff6900"
      },
      "to": {
        "$value": "#f54900"
      }
    }
  },
  "queue": {
    "background": {
      "$type": "color",
      "$value": "#f8f4ff"
    },
    "separator": {
      "$type": "color",
      "$value": "#cad5e2"
    },
    "card": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "card_border": {
      "$type": "color",
      "$value": "#e2e8f0"
    },
