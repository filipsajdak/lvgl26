{
  "$description": "Design tokens of the treadmill panel after the Qt Design Studio example TreadmillMcuDemo (BSD-3-Clause, Copyright The Qt Company Ltd). The three themes and their colors are the original's.",
  "font": {
    "text": {
      "$type": "fontFamily",
      "$value": "Exo"
    }
  },
  "text": {
    "$type": "typography",
    "unit": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "14px",
        "fontWeight": 500,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "16px",
        "fontWeight": 500,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "20px",
        "fontWeight": 500,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "button": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "20px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "count": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "30px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "pace": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "32px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "value": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "48px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    },
    "clock": {
      "$value": {
        "fontFamily": "{font.text}",
        "fontSize": "72px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": 1.2
      }
    }
  },
  "theme": {
    "light": {
      "white": {
        "$type": "color",
        "$value": "#fafafa"
      },
      "stop_red": {
        "$type": "color",
        "$value": "#a72f0b"
      },
      "start_green": {
        "$type": "color",
        "$value": "#009b77"
      },
      "secondary": {
        "$type": "color",
        "$value": "#767676"
      },
      "primary": {
        "$type": "color",
        "$value": "#222222"
      },
      "pause_gray": {
        "$type": "color",
        "$value": "#9f9f9f"
      },
      "nav_bar": {
        "$type": "color",
        "$value": "#fcfcfc"
      },
      "button_bar": {
        "$type": "color",
        "$value": "#fbfbfb"
      },
      "black": {
        "$type": "color",
        "$value": "#222222"
      },
      "background": {
        "$type": "color",
        "$value": "#fafafa"
      }
    },
    "dark": {
      "white": {
        "$type": "color",
        "$value": "#fafafa"
      },
      "stop_red": {
        "$type": "color",
        "$value": "#a72f0b"
      },
      "start_green": {
        "$type": "color",
        "$value": "#009b77"
      },
      "secondary": {
        "$type": "color",
        "$value": "#767676"
      },
      "primary": {
        "$type": "color",
        "$value": "#fafafa"
      },
      "pause_gray": {
        "$type": "color",
        "$value": "#9f9f9f"
      },
      "nav_bar": {
        "$type": "color",
        "$value": "#a1a1a1"
