      "button_bar": {
        "$type": "color",
        "$value": "#696969"
      },
      "black": {
        "$type": "color",
        "$value": "#222222"
      },
      "background": {
        "$type": "color",
        "$value": "#434343"
      }
    },
    "sporty": {
      "white": {
        "$type": "color",
        "$value": "#fafafa"
      },
      "stop_red": {
        "$type": "color",
        "$value": "#a72f0b"
      },
      "start_green": {
        "$type": "color",
        "$value": "#009b77"
      },
      "secondary": {
        "$type": "color",
        "$value": "#767676"
      },
      "primary": {
        "$type": "color",
        "$value": "#222222"
      },
      "pause_gray": {
        "$type": "color",
        "$value": "#9f9f9f"
      },
      "nav_bar": {
        "$type": "color",
        "$value": "#f9ab91"
      },
      "button_bar": {
        "$type": "color",
        "$value": "#d06444"
      },
      "black": {
        "$type": "color",
        "$value": "#222222"
      },
      "background": {
        "$type": "color",
        "$value": "#d94b23"
      }
    }
  },
  "label": {
    "on_button": {
      "$type": "color",
      "$value": "#fafafa"
    }
  },
  "line": {
    "stroke": {
      "$type": "color",
      "$value": "#434343",
      "$description": "The hairline under the bar and the border of the button bar."
    },
    "width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "divider": {
      "$type": "color",
      "$value": "#bebebe"
    },
    "divider_width": {
      "$type": "dimension",
      "$value": "5px"
    }
  },
  "ring": {
    "color": {
      "$type": "color",
      "$value": "#bf360c"
    },
    "width": {
      "$type": "dimension",
      "$value": "5px"
    },
    "fill": {
      "$type": "color",
      "$value": "#f5f5f5"
    },
    "fill_strength": {
      "$type": "number",
      "$value": 0.8
    },
    "radius": {
      "$type": "dimension",
      "$value": "60px"
    }
  },
  "arrow": {
    "rim": {
      "$type": "color",
      "$value": "#767676"
    },
    "face": {
      "$type": "color",
      "$value": "#222222"
    },
    "rim_down": {
      "$type": "color",
      "$value": "#222222"
    },
    "face_down": {
      "$type": "color",
      "$value": "#bf360c"
    },
    "rim_width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "radius": {
      "$type": "dimension",
      "$value": "8px"
    }
  },
  "button": {
    "radius": {
      "$type": "dimension",
      "$value": "8px"
    },
    "rim_width": {
      "$type": "dimension",
      "$value": "6px"
    }
  },
  "splash": {
    "top": {
      "$type": "color",
      "$value": "#ff5722",
      "$description": "The top of the original backdrop (bg.png)."
    },
    "bottom": {
      "$type": "color",
      "$value": "#bf360c",
      "$description": "The bottom of the original backdrop."
    }
  },
  "toggle": {
    "radius": {
      "$type": "dimension",
      "$value": "20px"
    }
  },
  "marker": {
    "radius": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "bar": {
    "radius": {
      "$type": "dimension",
      "$value": "8px"
    }
  },
  "space": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    }
  },
  "solid": {
    "$type": "number",
    "$value": 1
  },
  "clear": {
    "$type": "number",
    "$value": 0
  },
  "tint": {
    "$type": "number",
    "$value": 1
  }
}
