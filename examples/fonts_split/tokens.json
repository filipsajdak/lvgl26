{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The typography of the fonts_split example: the roles of the fonts example, each font drawn in a file of its own.",
  "font": {
    "text": { "$type": "fontFamily", "$value": "Barlow" },
    "display": { "$type": "fontFamily", "$value": "Barlow Condensed" }
  },
  "text": {
    "$type": "typography",
    "label": {
      "$value": { "fontFamily": "{font.text}", "fontSize": {"value": 16, "unit": "px"}, "fontWeight": 500, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1.3 }
    },
    "title": {
      "$value": { "fontFamily": "{font.text}", "fontSize": {"value": 28, "unit": "px"}, "fontWeight": 500, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1.2 }
    },
    "numeral": {
      "$value": { "fontFamily": "{font.display}", "fontSize": {"value": 96, "unit": "px"}, "fontWeight": 600, "letterSpacing": {"value": 0, "unit": "px"}, "lineHeight": 1 }
    }
  }
}
