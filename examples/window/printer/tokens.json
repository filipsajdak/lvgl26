{
  "$description": "Design tokens of the printer panel, theme 'Gradient'. Colors and sizes after the Slint printer demo (MIT, design by Matthias Grimme).",
  "window": {
    "background": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "radius": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "sidebar": {
    "background": {
      "$type": "color",
      "$value": "#0e172b"
    },
    "active": {
      "$type": "color",
      "$value": "#1d293d"
    },
    "icon": {
      "$type": "color",
      "$value": "#90a1b9"
    },
    "icon-active": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "icon-radius": {
      "$type": "dimension",
      "$value": "16px"
    }
  },
  "text": {
    "primary": {
      "$type": "color",
      "$value": "#1d293d"
    },
    "tertiary": {
      "$type": "color",
      "$value": "#62748e"
    },
    "on-tile": {
      "$type": "color",
      "$value": "#ffffff"
    }
  },
  "tile": {
    "radius": {
      "$type": "dimension",
      "$value": "24px"
    },
    "inner-radius": {
      "$type": "dimension",
      "$value": "16px"
    },
    "inner": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "inner-strength": {
      "$type": "number",
      "$value": 0.2
    },
    "print": {
      "$type": "color",
      "from": {
        "$value": "#2b7fff"
      },
      "to": {
        "$value": "#155dfc"
      }
    },
    "scan": {
      "$type": "color",
      "from": {
        "$value": "#00bc7d"
      },
      "to": {
        "$value": "#009966"
      }
    },
    "copy": {
      "$type": "color",
      "from": {
        "$value": "#ff2056"
      },
      "to": {
        "$value": "#fd3d6d"
      }
    },
    "usb": {
      "$type": "color",
      "from": {
        "$value": "#ff6900"
      },
      "to": {
        "$value": "#f54900"
      }
    }
  },
  "queue": {
    "background": {
      "$type": "color",
      "$value": "#f8f4ff"
    },
    "separator": {
      "$type": "color",
      "$value": "#cad5e2"
    }
  },
  "solid": {
    "$type": "number",
    "$value": 1
  },
  "tint": {
    "$type": "number",
    "$value": 1
  },
  "header": {
    "background": {
      "$type": "color",
      "$value": "#f8fafc"
    },
    "separator": {
      "$type": "color",
      "$value": "#cad5e2"
    }
  },
  "button": {
    "primary": {
      "$type": "color",
      "$value": "#2b7fff"
    },
    "text": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "radius": {
      "$type": "dimension",
      "$value": "12px"
    },
    "color": {
      "$type": "color",
      "from": {
        "$value": "#ff3b30"
      },
      "to": {
        "$value": "#af52de"
      }
    }
  },
  "spinbox": {
    "button": {
      "$type": "color",
      "$value": "#277aff"
    },
    "text": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "radius": {
      "$type": "dimension",
      "$value": "10px"
    }
  },
  "motion": {
    "slide": {
      "$type": "cubicBezier",
      "$description": "CSS 'ease': how a sub-page slides in and out.",
      "$value": [
        0.25,
        0.1,
        0.25,
        1.0
      ]
    }
  }
}
