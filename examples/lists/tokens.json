{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The tokens of the list example: a dark playlist.",
  "color": {
    "$type": "color",
    "screen": { "$value": "#14161a" },
    "row": { "$value": "#1f232a" },
    "selected": { "$value": "#2f6fdf" },
    "text": { "$value": "#e8ebf0" },
    "quiet": { "$value": "#8a93a3" },
    "on-selected": { "$value": "#ffffff" }
  },
  "space": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "gap": { "$value": "6px" },
    "edge": { "$value": "12px" }
  },
  "radius": {
    "$type": "dimension",
    "row": { "$value": "6px" }
  },
  "opacity": {
    "$type": "number",
    "opaque": { "$value": 1 }
  }
}
