{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The tokens of the list example: a dark playlist.",
  "color": {
    "$type": "color",
    "screen": { "$value": {"colorSpace": "srgb", "components": [0.0784, 0.0863, 0.102], "hex": "#14161a"} },
    "row": { "$value": {"colorSpace": "srgb", "components": [0.1216, 0.1373, 0.1647], "hex": "#1f232a"} },
    "selected": { "$value": {"colorSpace": "srgb", "components": [0.1843, 0.4353, 0.8745], "hex": "#2f6fdf"} },
    "text": { "$value": {"colorSpace": "srgb", "components": [0.9098, 0.9216, 0.9412], "hex": "#e8ebf0"} },
    "quiet": { "$value": {"colorSpace": "srgb", "components": [0.5412, 0.5765, 0.6392], "hex": "#8a93a3"} },
    "on-selected": { "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"} }
  },
  "space": {
    "$type": "dimension",
    "none": { "$value": {"value": 0, "unit": "px"} },
    "gap": { "$value": {"value": 6, "unit": "px"} },
    "edge": { "$value": {"value": 12, "unit": "px"} }
  },
  "radius": {
    "$type": "dimension",
    "row": { "$value": {"value": 6, "unit": "px"} }
  },
  "opacity": {
    "$type": "number",
    "opaque": { "$value": 1 }
  }
}
