{
 "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
 "$description": "The design of the looks example: values first, then one group for each look. A group's entries are named for the style properties they set.",
 "font": {
  "text": {
   "$type": "fontFamily",
   "$value": "Barlow"
  }
 },
 "text": {
  "$type": "typography",
  "body": {
   "$value": {
    "fontFamily": "{font.text}",
    "fontSize": "14px",
    "fontWeight": 500,
    "lineHeight": 1.2,
    "letterSpacing": "0px"
   }
  },
  "label": {
   "$value": {
    "fontFamily": "{font.text}",
    "fontSize": "16px",
    "fontWeight": 500,
    "lineHeight": 1.2,
    "letterSpacing": "0px"
   }
  },
  "title": {
   "$value": {
    "fontFamily": "{font.text}",
    "fontSize": "24px",
    "fontWeight": 500,
    "lineHeight": 1.2,
    "letterSpacing": "0px"
   }
  }
 },
 "color": {
  "$type": "color",
  "paper": {
   "$value": "#f1f5f9"
  },
  "ink": {
   "$value": "#1d293d"
  },
  "gray": {
   "$value": "#62748e"
  },
  "white": {
   "$value": "#ffffff"
  },
  "green": {
   "$value": "#00a63e"
  },
  "blue": {
   "$value": "#2b7fff"
  },
  "blue_deep": {
   "$value": "#155dfc"
  },
  "teal": {
   "$value": "#00bc7d"
  },
  "teal_deep": {
   "$value": "#009966"
  },
  "red": {
   "$value": "#ff2056"
  },
  "red_deep": {
   "$value": "#fd3d6d"
  },
  "ink_pressed": {
   "$value": "#314158"
  }
 },
 "space": {
  "$type": "dimension",
  "page": {
   "$value": "16px"
  },
  "gap": {
   "$value": "12px"
  }
 },
 "page": {
  "bg_color": {
   "$value": "{color.paper}"
  },
  "bg_opa": {
   "$type": "number",
   "$value": 1
  },
  "pad_all": {
   "$value": "{space.page}"
  },
  "pad_row": {
   "$value": "{space.gap}"
  },
  "text_color": {
   "$value": "{color.ink}"
  },
  "text_font": {
   "$value": "{text.body}"
  },
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "layout": "flex",
    "flex_flow": "column"
   }
  }
 },
 "title": {
  "text_font": {
   "$value": "{text.title}"
  }
 },
 "tiles": {
  "pad_column": {
   "$value": "{space.gap}"
  },
  "width": {
   "$type": "dimension",
   "$value": "288px"
  },
  "height": {
   "$type": "dimension",
   "$value": "104px"
  },
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "layout": "flex",
    "flex_flow": "row"
   }
  }
 },
 "tile": {
  "width": {
   "$type": "dimension",
   "$value": "88px"
  },
  "height": {
   "$type": "dimension",
   "$value": "104px"
  },
  "radius": {
   "$type": "dimension",
   "$value": "16px"
  },
  "bg_opa": {
   "$type": "number",
   "$value": 1
  },
  "shadow_width": {
   "$type": "dimension",
   "$value": "0px"
  },
  "text_color": {
   "$value": "{color.white}"
  },
  "text_font": {
   "$value": "{text.label}"
  },
  "pressed": {
   "bg_opa": {
    "$type": "number",
    "$value": 0.8
   }
  },
  "$extensions": {
   "io.github.filipsajdak.lvgl26": {
    "bg_grad_dir": "ver",
    "layout": "flex",
    "flex_flow": "column",
    "flex_main_place": "center",
    "flex_cross_place": "center",
    "flex_track_place": "center"
   }
  }
 },
 "status": {
  "text_color": {
   "$value": "{color.gray}"
  },
  "checked": {
   "text_color": {
    "$value": "{color.green}"
   }
  }
 },
 "tile-print": {
  "bg_color": {
   "$value": "{color.blue}"
  },
  "bg_grad_color": {
   "$value": "{color.blue_deep}"
  }
 },
 "tile-scan": {
  "bg_color": {
   "$value": "{color.teal}"
  },
  "bg_grad_color": {
   "$value": "{color.teal_deep}"
  }
 },
 "tile-copy": {
  "bg_color": {
   "$value": "{color.red}"
  },
  "bg_grad_color": {
   "$value": "{color.red_deep}"
  }
 }
}