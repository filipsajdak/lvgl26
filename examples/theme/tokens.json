{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The tokens of the example's own theme: a paper look.",
  "color": {
    "$type": "color",
    "paper": { "$value": {"colorSpace": "srgb", "components": [0.9569, 0.9373, 0.902], "hex": "#f4efe6"} },
    "ink": { "$value": {"colorSpace": "srgb", "components": [0.1333, 0.1255, 0.1098], "hex": "#22201c"} },
    "rule": { "$value": {"colorSpace": "srgb", "components": [0.8118, 0.7765, 0.7137], "hex": "#cfc6b6"} },
    "accent": { "$value": {"colorSpace": "srgb", "components": [0.702, 0.251, 0.1647], "hex": "#b3402a"} },
    "on-accent": { "$value": {"colorSpace": "srgb", "components": [1, 0.9804, 0.9412], "hex": "#fffaf0"} }
  },
  "space": {
    "$type": "dimension",
    "none": { "$value": {"value": 0, "unit": "px"} },
    "gap": { "$value": {"value": 12, "unit": "px"} },
    "edge": { "$value": {"value": 16, "unit": "px"} },
    "button-x": { "$value": {"value": 20, "unit": "px"} },
    "button-y": { "$value": {"value": 10, "unit": "px"} }
  },
  "stroke": {
    "$type": "dimension",
    "ring": { "$value": {"value": 6, "unit": "px"} }
  },
  "radius": {
    "$type": "dimension",
    "button": { "$value": {"value": 6, "unit": "px"} }
  },
  "opacity": {
    "$type": "number",
    "opaque": { "$value": 1 },
    "none": { "$value": 0 }
  }
}
