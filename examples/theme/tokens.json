{
  "$description": "The tokens of the example's own theme: a paper look.",
  "color": {
    "$type": "color",
    "paper": { "$value": "#f4efe6" },
    "ink": { "$value": "#22201c" },
    "rule": { "$value": "#cfc6b6" },
    "accent": { "$value": "#b3402a" },
    "on-accent": { "$value": "#fffaf0" }
  },
  "space": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "gap": { "$value": "12px" },
